# ============================================
# Docker 构建时忽略的文件（减小镜像体积）
# ============================================

# Python 缓存
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# 环境变量（不打包真实密码，通过运行时注入）
.env
*.env.local

# IDE 配置
.idea/
.vscode/
*.iml

# Node 依赖
node_modules/

# Git
.git/
.gitignore

# 系统文件
.DS_Store
Thumbs.db

# 日志
*.log
logs/

# 测试
.pytest_cache/